local tween = require("game.core.tween")
local visual_status = require("game.dev.visual_status")
local game_bridge = require("main.game_bridge")

local LOCATION_Y = {
	bidding = -410,
	setup = -410,
	shaking = 720,
	dualing = 720,
}

local PAN_TIME = 0.6

function init(self)
	self.location = "bidding"
	visual_status.set("background", {
		location = self.location,
		target_y = LOCATION_Y.bidding,
		position_y = -410,
	})
end

local function report_background(self, target_y)
	local pos = go.get_position(".")
	visual_status.set("background", {
		location = self.location,
		target_y = target_y,
		position_y = pos.y,
	})
end

function on_message(self, message_id, message, sender)
	if message_id ~= hash("pan_to") then
		return
	end

	local location = message.location or "shaking"
	local y = LOCATION_Y[location] or LOCATION_Y.shaking
	self.location = location
	report_background(self, y)

	if game_bridge.is_web() then
		go.set_position(vmath.vector3(640, y, 0), ".")
		report_background(self, y)
		msg.post(sender, "background_pan_complete", {
			location = location,
		})
		return
	end

	tween.to(".", "position.y", y, PAN_TIME, go.EASING_INOUTQUAD, function()
		report_background(self, y)
		msg.post(sender, "background_pan_complete", {
			location = location,
		})
	end)
end
