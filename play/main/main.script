local bridge = require("main.game_bridge")
local event_bus = require("game.core.event_bus")
local cosmetics = require("game.core.cosmetics")
local reducers = require("game.model.reducers")
local store_mod = require("game.model.store")
local match_adapter = require("game.net.match_adapter")
local i18n = require("game.core.i18n")
local qa_cli = require("game.dev.qa_cli")

local LOCALE_TARGETS = {
	"/ui#turn_indicator",
	"/ui#shake",
	"/ui#local_hud",
	"/ui#player_carousel",
	"/ui#bid_controls",
	"/ui#rail",
	"/ui#duel",
	"/cylinder#cylinder_gui",
}

local function submit_result_once(self)
	if self.result_submitted or not self.adapter then
		return
	end

	self.result_submitted = true
	self.adapter:submit_result()
end

-- Dev-only QA harness: standalone 번들(local simulator)에서만 동작하는
-- local reducer smoke tool. Convex server-authority 경로와 무관하다.
-- 게이트(mode == "dev" and local_simulator)는 qa_cli.process_bridge_command가 검사한다.
local function try_handle_qa_message(self, message)
	if message.type ~= "QA_COMMAND" or not self.qa_cli then
		return false
	end

	local snapshot = qa_cli.process_bridge_command(self.qa_cli, message.payload or {})
	if snapshot then
		bridge.emit("QA_STATUS", snapshot)
	end
	return true
end

local function try_handle_dom_pointer(message)
	if message.type ~= "DOM_POINTER" then
		return false
	end

	msg.post("/cylinder#cylinder", "pointer_input", message.payload or {})
	return true
end

local function try_handle_locale_message(message)
	if message.type ~= "SET_LOCALE" then
		return false
	end

	local payload = message.payload or {}
	local applied = i18n.set_locale(payload.locale)
	if applied then
		for _, target in ipairs(LOCALE_TARGETS) do
			msg.post(target, "locale_changed")
		end
	end

	bridge.emit("LOCALE_APPLIED", {
		locale = i18n.get_locale(),
		applied = applied,
	})
	return true
end

local function start_dev_match(self)
	if bridge.is_web() then
		return
	end

	self.adapter:on_bridge_message({
		type = "START_MATCH",
		payload = {
			sessionId = "dev-session",
			matchId = "dev-match",
			playerId = "local-player",
			mode = "dev",
			locale = "ko",
			players = {
				{ id = "local-player", name = "You", hp = 3, dice_count = 5, skin = "rosemund" },
				{ id = "opponent-1", name = "Hush Feather", hp = 3, dice_count = 5, skin = "hush-feather", initial_loaded_slots = { 1, 3, 5 } },
				{ id = "opponent-2", name = "Samuel Saber", hp = 3, dice_count = 5, skin = "samuel-saber", initial_loaded_slots = { 1, 3, 5 } },
				{ id = "opponent-3", name = "Zippo Jay", hp = 3, dice_count = 5, skin = "zippo-jay", initial_loaded_slots = { 1, 3, 5 } },
			},
		},
	})
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.state = "booting"
	self.bus = event_bus.new()
	self.store = store_mod.create(reducers.initial_state(), reducers.reduce, self.bus)
	self.adapter = match_adapter.new(bridge, self.store, cosmetics)
	self.qa_cli = qa_cli.new(self.store)
	self.match_changed = false
	self.result_submitted = false
	i18n.set_locale("ko")

	self.result_sub = self.store:subscribe("match", function(state)
		self.state = state.match.status
		self.match_changed = true
	end)

	bridge.install()
	self.state = "idle"

	bridge.emit("DEFOLD_READY", {
		state = self.state
	})

	msg.post("#director", "boot")
	start_dev_match(self)
end

function update(self, dt)
	if self.match_changed then
		self.match_changed = false
		if self.store:get_state().match.status == "complete" then
			submit_result_once(self)
		end
	end

	if self.qa_cli and not bridge.is_web() then
		qa_cli.poll(self.qa_cli)
	end

	while true do
		local message = bridge.poll()
		if not message then
			break
		end

		if not try_handle_locale_message(message)
			and not try_handle_dom_pointer(message)
			and not try_handle_qa_message(self, message) then
			self.adapter:on_bridge_message(message)
		end
	end
end

function on_message(self, message_id)
	if message_id == hash("submit_result") then
		submit_result_once(self)
	end
end

function on_input(self, action_id, action)
	if (action_id == hash("pointer") or action_id == hash("touch")) and action.pressed then
		local input_source = action_id == hash("touch") and "touch" or "pointer"

		bridge.emit("INPUT_POINTER", {
			source = input_source,
			x = action.x,
			y = action.y,
			state = self.state
		})
	elseif action_id == hash("shake") and action.pressed then
		bridge.emit("INPUT_SHAKE", {
			state = self.state
		})
	end
end

function final(self)
	if self.store and self.result_sub then
		self.store:unsubscribe(self.result_sub)
	end
end
