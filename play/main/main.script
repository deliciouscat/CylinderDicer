local bridge = require("main.game_bridge")
local event_bus = require("game.core.event_bus")
local cosmetics = require("game.core.cosmetics")
local reducers = require("game.model.reducers")
local store_mod = require("game.model.store")
local match_adapter = require("game.net.match_adapter")
local i18n = require("game.core.i18n")
local qa_cli = require("game.dev.qa_cli")

local function start_dev_match(self)
	if bridge.is_web() then
		return
	end

	self.adapter:on_bridge_message({
		type = "START_MATCH",
		payload = {
			sessionId = "dev-session",
			matchId = "dev-match",
			playerId = "local-player",
			mode = "dev",
			locale = "ko",
			players = {
				{ id = "local-player", name = "You", hp = 3, dice_count = 5, skin = "rosemund" },
				{ id = "opponent-1", name = "Hush Feather", hp = 3, dice_count = 5, skin = "hush-feather", initial_loaded_slots = { 1, 3, 5 } },
				{ id = "opponent-2", name = "Samuel Saber", hp = 3, dice_count = 5, skin = "samuel-saber", initial_loaded_slots = { 1, 3, 5 } },
				{ id = "opponent-3", name = "Zippo Jay", hp = 3, dice_count = 5, skin = "zippo-jay", initial_loaded_slots = { 1, 3, 5 } },
			},
		},
	})
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.state = "booting"
	self.bus = event_bus.new()
	self.store = store_mod.create(reducers.initial_state(), reducers.reduce, self.bus)
	self.adapter = match_adapter.new(bridge, self.store, cosmetics)
	self.qa_cli = qa_cli.new(self.store)
	i18n.set_locale("ko")

	self.result_sub = self.store:subscribe("match", function(state)
		self.state = state.match.status

		if state.match.status == "complete" and not self.result_submitted then
			self.result_submitted = true
			self.adapter:submit_result()
		end
	end)

	bridge.install()
	self.state = "idle"

	bridge.emit("DEFOLD_READY", {
		state = self.state
	})

	msg.post("#director", "boot")
	start_dev_match(self)
end

function update(self, dt)
	if self.qa_cli and not bridge.is_web() then
		qa_cli.poll(self.qa_cli)
	end

	while true do
		local message = bridge.poll()
		if not message then
			break
		end

		self.adapter:on_bridge_message(message)
	end
end

function on_message(self, message_id)
	if message_id == hash("submit_result") and self.adapter then
		self.adapter:submit_result()
	end
end

function on_input(self, action_id, action)
	if (action_id == hash("pointer") or action_id == hash("touch")) and action.pressed then
		local input_source = action_id == hash("touch") and "touch" or "pointer"

		bridge.emit("INPUT_POINTER", {
			source = input_source,
			x = action.x,
			y = action.y,
			state = self.state
		})
	elseif action_id == hash("shake") and action.pressed then
		bridge.emit("INPUT_SHAKE", {
			state = self.state
		})
	end
end

function final(self)
	if self.store and self.result_sub then
		self.store:unsubscribe(self.result_sub)
	end
end
