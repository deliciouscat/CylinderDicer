local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local actions = require("game.model.actions")
local server_command = require("game.net.server_command")
local gestures = require("game.core.gestures")
local gui_util = require("ui.common.gui_util")
local table_seat_layout = require("ui.common.table_seat_layout")
local dice_art = require("ui.common.dice_art")
local shake_gauge = require("ui.shake.shake_gauge")
local audio = require("game.core.audio")
local i18n = require("game.core.i18n")
local visual_status = require("game.dev.visual_status")

local MAX_OPPONENTS = 5
local DICE_COUNT = 5
local DRAG_DISTANCE_PER_SHAKE = 72.0
local LOCAL_CUP_CLOSED_Y = 8.0
local LOCAL_CUP_REVEAL_Y = 88.0
local LOCAL_CUP_REVEAL_ALPHA = 0.88
local CUP_WIDTH = 220.0
local CUP_HEIGHT = 248.0
local LOCAL_CUP_Z = 0.2
local PHASE_CUP_SHAKE = "cup_shake"
local PHASE_DICE_CHECK = "dice_check"
local PHASE_BIDDING_GAP = "bidding_gap"

local function is_shake_phase(phase)
	return phase == PHASE_CUP_SHAKE
		or phase == PHASE_DICE_CHECK
		or phase == PHASE_BIDDING_GAP
end

local function visible_player_order(state)
	local order = {}
	for _, player_id in ipairs(state.players.order or {}) do
		local player = state.players.by_id[player_id]
		if player and not player.eliminated and (player.hp or 0) > 0 then
			order[#order + 1] = player_id
		end
	end
	return order
end

local function set_dice_visible(visible)
	gui_util.set_enabled("dice_tray", visible)
	for index = 1, DICE_COUNT do
		gui_util.set_enabled("reveal_dice_" .. tostring(index), visible)
		gui_util.set_enabled("tray_dice_" .. tostring(index), visible)
	end
end

local function render_dice(player, round_index)
	for index = 1, DICE_COUNT do
		local face = player and player.dice and player.dice[index]
		gui_util.play_flipbook(
			"reveal_dice_" .. tostring(index),
			dice_art.table_animation(face or 1, index, round_index)
		)
		gui_util.play_flipbook(
			"tray_dice_" .. tostring(index),
			dice_art.front_animation(face or 1)
		)
	end
end

local function render_cup_layout(self, state)
	local layout = table_seat_layout.build(
		visible_player_order(state),
		state.match.local_player_id,
		{
			local_cup_y = LOCAL_CUP_CLOSED_Y,
		}
	)

	self.local_cup_base_x = layout.local_seat.cup.x
	for index = 1, MAX_OPPONENTS do
		local id = "cup_seat_" .. tostring(index)
		local seat = layout.opponents[index]
		gui_util.set_enabled(id, seat ~= nil)
		if seat then
			gui_util.set_position(id, vmath.vector3(seat.cup.x, seat.cup.y, 0.2))
			gui_util.set_size(id, vmath.vector3(
				CUP_WIDTH * seat.cup.scale,
				CUP_HEIGHT * seat.cup.scale,
				0.0
			))
		end
	end
end

local function hint_for_phase(phase)
	if phase == PHASE_CUP_SHAKE then
		return i18n.t("hud.hint.shaking")
	end
	if phase == PHASE_DICE_CHECK then
		return i18n.t("hud.hint.dice_check")
	end
	return i18n.t("hud.hint.bidding_soon")
end

local function shake_round_token(state)
	return table.concat({
		tostring(state.match and state.match.match_id or "local"),
		tostring(state.turn and state.turn.round_index or 0),
		tostring(state.flow and state.flow.epoch or 0),
	}, ":")
end

local function render(self, state)
	local phase = selectors.phase(state)
	local active = is_shake_phase(phase)
	gui_util.set_enabled("root", active)
	if not active then
		return
	end

	render_cup_layout(self, state)

	local local_player_id = state.match.local_player_id
	local local_player = selectors.local_player(state)
	local status = selectors.shake_status(state, local_player_id)
	local reveal = phase == PHASE_DICE_CHECK or phase == PHASE_BIDDING_GAP
	local local_cup_target_y = reveal and LOCAL_CUP_REVEAL_Y or LOCAL_CUP_CLOSED_Y
	local local_cup_alpha = reveal and LOCAL_CUP_REVEAL_ALPHA or 1.0
	local token = shake_round_token(state)
	if phase == PHASE_CUP_SHAKE and self.gauge_token ~= token then
		self.gauge_token = token
		self.gauge = status.complete and shake_gauge.MAX or shake_gauge.MIN
		self.shake_submitted = status.complete
	elseif status.complete then
		self.gauge = shake_gauge.MAX
		self.shake_submitted = true
	end
	if phase == PHASE_DICE_CHECK and self.dice_check_token ~= token then
		self.dice_check_token = token
		self.dice_check_submitted = state.shake
			and state.shake.checked
			and state.shake.checked[local_player_id] == true
	end
	visual_status.set("shake", {
		phase = phase,
		hud = selectors.hud_kind(state),
		visible = active,
		reveal = reveal,
		gauge = self.gauge,
		gauge_max = shake_gauge.MAX,
		submitted = self.shake_submitted == true,
		server_complete = status.complete,
		local_player_id = local_player_id,
		local_cup_target_y = local_cup_target_y,
		local_cup_alpha = local_cup_alpha,
	})

	if self.last_shake_count and status.count > self.last_shake_count then
		self.shake_impulse = 0.18
	end
	self.last_shake_count = status.count
	self.local_cup_target_y = local_cup_target_y

	gui_util.set_alpha("cup_local", local_cup_alpha)
	gui_util.set_text("hint", hint_for_phase(phase))

	set_dice_visible(reveal)
	if reveal then
		render_dice(local_player, state.turn.round_index)
	end

end

local function request_render(self)
	self.needs_render = true
end

local function submit_shake_complete(self, state, player_id)
	if self.shake_submitted then
		return true
	end
	local submission = server_command.submit(state, "shake.complete")
	if submission.status == "local" then
		local result = self.store:dispatch(actions.shake_complete(player_id))
		self.shake_submitted = result and result.ok == true
		return self.shake_submitted
	end
	self.shake_submitted = submission.status == "sent"
	return self.shake_submitted
end

local function dispatch_shake(self)
	if not self.store then
		return false
	end

	local state = self.store:get_state()
	if selectors.phase(state) ~= PHASE_CUP_SHAKE then
		return false
	end

	local player_id = state.match.local_player_id
	local status = selectors.shake_status(state, player_id)
	if status.complete then
		return false
	end

	self.gauge = shake_gauge.add(self.gauge)
	self.shake_impulse = 0.18
	audio.play_sfx("roll")
	if shake_gauge.complete(self.gauge) then
		submit_shake_complete(self, state, player_id)
	end
	self.needs_render = true
	return true
end

local function dispatch_dice_check(self)
	if not self.store then
		return false
	end
	if self.dice_check_submitted then
		return false
	end
	local state = self.store:get_state()
	if selectors.phase(state) ~= PHASE_DICE_CHECK then
		return false
	end
	local submission = server_command.submit(state, "dice.check")
	if submission.status ~= "local" then
		self.dice_check_submitted = submission.status == "sent"
		return self.dice_check_submitted
	end
	local result = self.store:dispatch(actions.dice_check(state.match.local_player_id))
	self.dice_check_submitted = result and result.ok == true
	return self.dice_check_submitted
end

local function consume_drag(self, event)
	local dx = event.dx or 0.0
	local dy = event.dy or 0.0
	self.drag_distance = self.drag_distance + math.sqrt(dx * dx + dy * dy)

	while self.drag_distance >= DRAG_DISTANCE_PER_SHAKE do
		if not dispatch_shake(self) then
			self.drag_distance = 0.0
			return
		end
		self.drag_distance = self.drag_distance - DRAG_DISTANCE_PER_SHAKE
	end
end

local function update_local_cup(self, dt)
	local target_y = self.local_cup_target_y or LOCAL_CUP_CLOSED_Y
	self.local_cup_y = self.local_cup_y or target_y
	self.local_cup_y = self.local_cup_y + (target_y - self.local_cup_y) * math.min(1.0, dt * 10.0)

	local offset_x = 0.0
	local rotation = 0.0
	if (self.shake_impulse or 0.0) > 0.0 then
		self.shake_impulse = math.max(0.0, self.shake_impulse - dt)
		local wave = math.sin(self.elapsed * 64.0)
		offset_x = wave * 14.0
		rotation = wave * 0.055
	end

	gui.set_position(self.local_cup_node, vmath.vector3(
		(self.local_cup_base_x or 0.0) + offset_x,
		self.local_cup_y,
		LOCAL_CUP_Z
	))
	gui.set_rotation(self.local_cup_node, vmath.quat_rotation_z(rotation))
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end

	for _, topic in ipairs({ "turn", "players", "shake", "flow", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end

	render(self, self.store:get_state())
	return true
end

function init(self)
	self.store = nil
	self.gesture = gestures.new(nil)
	self.subs = {}
	self.needs_render = false
	self.drag_distance = 0.0
	self.elapsed = 0.0
	self.shake_impulse = 0.0
	self.local_cup_y = LOCAL_CUP_CLOSED_Y
	self.local_cup_target_y = LOCAL_CUP_CLOSED_Y
	self.local_cup_base_x = 0.0
	self.last_shake_count = nil
	self.gauge = shake_gauge.MIN
	self.gauge_token = nil
	self.shake_submitted = false
	self.dice_check_token = nil
	self.dice_check_submitted = false
	self.local_cup_node = gui.get_node("cup_local")

	gui.set_render_order(4)
	gui_util.acquire_input_focus()
	gui_util.set_enabled("root", false)
	set_dice_visible(false)

	bind_store(self)
end

function update(self, dt)
	self.elapsed = self.elapsed + dt
	bind_store(self)
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
	if self.store and selectors.phase(self.store:get_state()) == PHASE_CUP_SHAKE
		and not self.shake_submitted and not shake_gauge.complete(self.gauge) then
		local next_gauge = shake_gauge.decay(self.gauge, dt)
		if next_gauge ~= self.gauge then
			self.gauge = next_gauge
		end
	end
	update_local_cup(self, dt)
end

function on_input(self, action_id, action)
	if not self.store and not bind_store(self) then
		return
	end

	local phase = selectors.phase(self.store:get_state())
	if not is_shake_phase(phase) then
		return
	end

	local event = self.gesture:feed(action_id, action)
	if not event then
		return
	end

	if event.kind == "shake" then
		if phase == PHASE_CUP_SHAKE then
			dispatch_shake(self)
		elseif phase == PHASE_DICE_CHECK then
			dispatch_dice_check(self)
		end
	elseif event.kind == "drag" and phase == PHASE_CUP_SHAKE then
		consume_drag(self, event)
	elseif event.kind == "drag_end" then
		self.drag_distance = 0.0
	end
end

function on_message(self, message_id)
	bind_store(self)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	elseif message_id == hash("locale_changed") then
		request_render(self)
	end
end

function on_reload(self)
	bind_store(self)
	request_render(self)
end

function final(self)
	gui_util.release_input_focus()
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
