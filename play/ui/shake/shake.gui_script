local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local actions = require("game.model.actions")
local gestures = require("game.core.gestures")
local audio = require("game.core.audio")
local i18n = require("game.core.i18n")
local gui_util = require("ui.common.gui_util")

local function render(self, state)
	local active = state.turn.kind == "shaking" or state.turn.kind == "setup"
	gui_util.set_enabled("root", active)
	gui_util.set_text("hint", i18n.t(selectors.hint_key(state)))

	local player = selectors.local_player(state)
	local dice = player and player.dice or {}
	gui_util.set_text("dice_values", table.concat(dice, " "))
end

function init(self)
	self.store = store_mod.get()
	self.gesture = gestures.new(nil)
	self.subs = {}
	gui_util.acquire_input_focus()

	if not self.store then
		return
	end

	self.subs[#self.subs + 1] = self.store:subscribe("turn", function(state)
		render(self, state)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("players", function(state)
		render(self, state)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("ui", function(state)
		render(self, state)
	end)

	render(self, self.store:get_state())
end

function on_input(self, action_id, action)
	if not self.store then
		return
	end

	local state = self.store:get_state()
	if state.turn.kind ~= "shaking" then
		return
	end

	local event = self.gesture:feed(action_id, action)
	if event and event.kind == "shake" then
		audio.play_sfx("shake")
		self.store:dispatch(actions.shake_roll(state.match.local_player_id))
	end
end

function on_message(self, message_id)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
