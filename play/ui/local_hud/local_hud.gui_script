local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local i18n = require("game.core.i18n")
local anchors = require("game.core.anchors")
local gui_util = require("ui.common.gui_util")
local dice_art = require("ui.common.dice_art")
local character_art = require("ui.common.character_art")
local dice = require("game.model.rules.dice")

local LOCAL_PORTRAIT_HEIGHT = 220.0

local function register_anchor()
	local position = gui_util.world_position("cylinder_anchor")
	if position then
		anchors.register("hud", position, "gui")
	end
end

local function set_dice_enabled(enabled)
	for index = 1, 5 do
		gui_util.set_enabled("dice_" .. tostring(index) .. "_box", enabled)
		gui_util.set_enabled("dice_" .. tostring(index), false)
	end
	gui_util.set_enabled("dice_values", false)
end

local function hint_text(state)
	local bid = state.bidding and state.bidding.my_bid
	if selectors.is_hud(state, "bidding") and selectors.is_my_turn(state) and bid and bid.face == dice.SKULL_FACE then
		return i18n.t("hud.hint.bidding_skull")
	end

	return i18n.t(selectors.hint_key(state))
end

local function render(self, state)
	local player = selectors.local_player(state)
	if not player then
		return
	end

	local active = selectors.is_hud(state, "bidding")
	gui_util.set_enabled("root", active)
	gui_util.set_text("name", player.name or player.id)
	gui_util.set_text("hp", player.hp or 0)
	gui_util.set_text("bullets", selectors.player_bullets(player))
	gui_util.set_text("hint", hint_text(state))
	local portrait_texture = character_art.texture_name(player)
	gui_util.set_enabled("portrait_placeholder", portrait_texture ~= nil)
	if portrait_texture then
		gui_util.set_texture("portrait_placeholder", portrait_texture)
		gui_util.play_flipbook("portrait_placeholder", player.portrait_state or "front")
		gui_util.set_size("portrait_placeholder", vmath.vector3(
			character_art.portrait_width(player, LOCAL_PORTRAIT_HEIGHT),
			LOCAL_PORTRAIT_HEIGHT,
			0.0
		))
	end
	for index = 1, 5 do
		local face = player.dice[index]
		if face then
			gui_util.play_flipbook(
				"dice_" .. tostring(index) .. "_box",
				dice_art.front_animation(face)
			)
		end
	end

	set_dice_enabled(true)
	register_anchor()
end

local function request_render(self)
	self.needs_render = true
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end

	for _, topic in ipairs({ "players", "turn", "flow", "ui", "bidding" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end

	render(self, self.store:get_state())
	return true
end

function init(self)
	self.store = nil
	self.subs = {}
	self.needs_render = false
	gui.set_render_order(5)
	gui_util.set_enabled("root", false)

	bind_store(self)
end

function update(self, dt)
	bind_store(self)
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
	register_anchor()
end

function on_message(self, message_id)
	if message_id == hash("locale_changed") then
		request_render(self)
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
