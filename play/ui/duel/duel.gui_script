local i18n = require("game.core.i18n")
local flow_contract = require("game.flow_contract")
local audio = require("game.core.audio")
local store_mod = require("game.model.store")
local gui_util = require("ui.common.gui_util")
local dice_art = require("ui.common.dice_art")
local table_seat_layout = require("ui.common.table_seat_layout")
local duel_view = require("ui.duel.duel_view")
local visual_status = require("game.dev.visual_status")

local MAX_PLAYERS = 6
local DICE_COUNT = 5
local GRID_MAX = 30
local REVEAL_INTERVAL = flow_contract.DUEL_REVEAL_INTERVAL_SECONDS
local REVEAL_DURATION = flow_contract.DUEL_REVEAL_DURATION_SECONDS
local CUP_WIDTH = 180.0
local CUP_HEIGHT = 202.0
local EXECUTE_INTRO_SECONDS = flow_contract.DUEL_EXECUTE_INTRO_SECONDS
local ROULETTE_STEP_SECONDS = flow_contract.DUEL_ROULETTE_STEP_SECONDS
local PERFECT_DUEL_STEP_SECONDS = flow_contract.DUEL_PERFECT_STEP_SECONDS
local HIT_APPLY_PROGRESS = 0.42
local LOCAL_REVEAL_DICE_OFFSET_Y = 50.0
local OPPONENT_REVEAL_DICE_OFFSET_Y = 64.0

local TEXTURE_BY_SKIN = {
	["rosemund"] = "rosemund",
	["hush-feather"] = "hush_feather",
	["samuel-saber"] = "samuel_saber",
	["zippo-jay"] = "zippo_jay",
	["calamity-kate"] = "calamity_kate",
	["the-kid"] = "the_kid",
}

local REVEAL_NODE_IDS = {
	"reveal_group",
}

local COMBAT_NODE_IDS = {
	"combat_group",
}

local DICE_OFFSETS = {
	{ x = -50.0, y = -8.0 },
	{ x = -22.0, y = 12.0 },
	{ x = 8.0, y = -12.0 },
	{ x = 38.0, y = 10.0 },
	{ x = 64.0, y = -12.0 },
}

local function ease(value)
	local t = math.max(0.0, math.min(1.0, value))
	return t * t * (3.0 - 2.0 * t)
end

local function clamp01(value)
	return math.max(0.0, math.min(1.0, value or 0.0))
end

local function set_nodes_enabled(ids, enabled)
	for _, id in ipairs(ids) do
		gui_util.set_enabled(id, enabled)
	end
end

local function set_node_enabled(node, enabled)
	if node then
		gui.set_enabled(node, enabled == true)
	end
end

local function set_node_position(node, position)
	if node then
		gui.set_position(node, position)
	end
end

local function set_node_size(node, size)
	if node then
		gui.set_size(node, size)
	end
end

local function set_node_alpha(node, alpha)
	if node then
		gui.set_alpha(node, alpha)
	end
end

local function play_node_flipbook(node, animation)
	if node then
		gui.play_flipbook(node, animation)
	end
end

local function clone_template(template_id)
	local template = gui_util.node(template_id)
	local node = gui.clone(template)
	gui.set_enabled(node, false)
	return node
end

local function build_runtime_nodes(self)
	self.player_dice_nodes = {}
	for player_index = 1, MAX_PLAYERS do
		self.player_dice_nodes[player_index] = {}
		for dice_index = 1, DICE_COUNT do
			self.player_dice_nodes[player_index][dice_index] = clone_template("player_dice_template")
		end
	end

	self.grid_dice_nodes = {}
	for index = 1, GRID_MAX do
		self.grid_dice_nodes[index] = clone_template("grid_dice_template")
	end

	self.tray_dice_nodes = {}
	for index = 1, DICE_COUNT do
		self.tray_dice_nodes[index] = clone_template("tray_dice_template")
	end

	gui_util.set_enabled("player_dice_template", false)
	gui_util.set_enabled("grid_dice_template", false)
	gui_util.set_enabled("tray_dice_template", false)
end

local function snapshot_by_id(duel)
	local result = {}
	for _, player in ipairs((duel and duel.players) or {}) do
		result[player.id] = player
	end
	return result
end

local function player_by_id(state, player_id)
	return state.players.by_id[player_id]
end

local function player_name(player)
	return player and (player.name or player.id) or "-"
end

local function texture_name(player)
	return player and (TEXTURE_BY_SKIN[player.skin] or TEXTURE_BY_SKIN[player.id]) or "rosemund"
end

local function alive_order(state)
	local order = {}
	for _, player_id in ipairs(state.players.order or {}) do
		local player = state.players.by_id[player_id]
		if player and not player.eliminated and (player.hp or 0) > 0 then
			order[#order + 1] = player_id
		end
	end
	return order
end

local function opponent_seats_by_id(layout)
	local result = {}
	for _, seat in ipairs(layout.opponents or {}) do
		result[seat.player_id] = seat
	end
	return result
end

local function reveal_progress(self, index)
	local elapsed = (self.reveal_elapsed or 0.0) - (index - 1) * REVEAL_INTERVAL
	if elapsed <= 0.0 then
		return 0.0
	end
	return ease(elapsed / REVEAL_DURATION)
end

local function hide_player_slot(self, index)
	gui_util.set_enabled("duel_cup_" .. tostring(index), false)
	for dice_index = 1, DICE_COUNT do
		set_node_enabled(self.player_dice_nodes[index] and self.player_dice_nodes[index][dice_index], false)
	end
end

local function hide_unused_players(self, count)
	for index = count + 1, MAX_PLAYERS do
		hide_player_slot(self, index)
	end
end

local function hide_reveal_nodes(self)
	set_nodes_enabled(REVEAL_NODE_IDS, false)
	for index = 1, MAX_PLAYERS do
		hide_player_slot(self, index)
	end
	for index = 1, GRID_MAX do
		set_node_enabled(self.grid_dice_nodes[index], false)
	end
	for index = 1, DICE_COUNT do
		set_node_enabled(self.tray_dice_nodes[index], false)
	end
end

local function hide_combat_nodes()
	set_nodes_enabled(COMBAT_NODE_IDS, false)
end

local function render_player_dice(self, index, player, seat, is_local, progress, round_index)
	local scale = is_local and 0.86 or (0.64 + (seat.depth or 0.0) * -0.08)
	local dice_size = is_local and 56.0 or 46.0
	local anchor_y = seat.cup.y - (is_local and LOCAL_REVEAL_DICE_OFFSET_Y or OPPONENT_REVEAL_DICE_OFFSET_Y)
	for dice_index = 1, DICE_COUNT do
		local node = self.player_dice_nodes[index] and self.player_dice_nodes[index][dice_index]
		local face = player.dice and player.dice[dice_index]
		local offset = DICE_OFFSETS[dice_index]
		set_node_enabled(node, progress > 0.02 and face ~= nil)
		if face then
			set_node_position(node, vmath.vector3(
				seat.cup.x + offset.x * scale,
				anchor_y + offset.y * scale,
				0.42 + dice_index * 0.01
			))
			set_node_size(node, vmath.vector3(dice_size * scale, dice_size * scale, 0.0))
			set_node_alpha(node, progress)
			play_node_flipbook(node, dice_art.table_animation(
				face,
				(index - 1) * DICE_COUNT + dice_index,
				round_index
			))
		end
	end
end

local function render_player_cup(index, seat, is_local, progress)
	local id = "duel_cup_" .. tostring(index)
	local scale = is_local and 0.9 or seat.cup.scale
	local lift = (is_local and 70.0 or 50.0) * progress
	gui_util.set_enabled(id, true)
	gui_util.set_position(id, vmath.vector3(seat.cup.x, seat.cup.y + lift, 0.28))
	gui_util.set_size(id, vmath.vector3(CUP_WIDTH * scale, CUP_HEIGHT * scale, 0.0))
	gui_util.set_alpha(id, 0.82 - 0.56 * progress)
end

local function grid_face_matches(face, bid_face)
	return face == bid_face or (bid_face ~= 1 and face == 1)
end

local function collect_grid_faces(self, state, order, players)
	local faces = {}
	local bid_face = state.duel and state.duel.bid and state.duel.bid.face or 1
	for index, player_id in ipairs(order) do
		local player = players[player_id]
		if player and reveal_progress(self, index) > 0.98 then
			for _, face in ipairs(player.dice or {}) do
				if grid_face_matches(face, bid_face) then
					faces[#faces + 1] = face
				end
			end
		end
	end
	table.sort(faces)
	return faces
end

local function all_revealed(self, order)
	for index = 1, #order do
		if reveal_progress(self, index) <= 0.98 then
			return false
		end
	end
	return #order > 0
end

local function reveal_complete_time(order)
	if #order <= 0 then
		return 0.0
	end
	return (#order - 1) * REVEAL_INTERVAL + REVEAL_DURATION
end

local function render_grid(self, state, order, players)
	local duel = state.duel or {}
	local bid = duel.bid or {}
	local faces = collect_grid_faces(self, state, order, players)
	local actual = duel.judge and duel.judge.actual or #faces

	gui_util.set_text("grid_label", i18n.t("duel.reveal.grid"))
	gui_util.set_text("bid_summary", i18n.t("duel.reveal.bid", {
		count = bid.count or "-",
		face = bid.face or "-",
	}))

	if all_revealed(self, order) then
		gui_util.set_text("actual_summary", i18n.t("duel.reveal.actual", {
			count = actual,
		}))
	else
		gui_util.set_text("actual_summary", i18n.t("duel.reveal.actual_pending"))
	end

	for index = 1, GRID_MAX do
		local node = self.grid_dice_nodes[index]
		local face = faces[index]
		set_node_enabled(node, face ~= nil)
		if face then
			local col = (index - 1) % 6
			local row = math.floor((index - 1) / 6)
			set_node_position(node, vmath.vector3((col - 2.5) * 48.0, 54.0 - row * 44.0, 0.12))
			play_node_flipbook(node, dice_art.front_animation(face))
		end
	end
	return #faces
end

local function render_local_tray(self, state, players)
	local local_player = players[state.match.local_player_id] or state.players.by_id[state.match.local_player_id]
	for index = 1, DICE_COUNT do
		local face = local_player and local_player.dice and local_player.dice[index]
		local node = self.tray_dice_nodes[index]
		set_node_enabled(node, face ~= nil)
		if face then
			set_node_position(node, vmath.vector3((index - 3) * 110.0, 0.0, 0.1))
			play_node_flipbook(node, dice_art.front_animation(face))
		end
	end
end

local function player_status_alpha(player, hp_override)
	local visible_hp = hp_override ~= nil and hp_override or (player and player.hp or 0)
	if visible_hp <= 0 then
		return 0.5
	end
	return 1.0
end

local function set_badges(prefix, player, hp_override, bullets_override, alpha)
	gui_util.set_text(prefix .. "_bullets", bullets_override ~= nil and bullets_override or (player and (player.bullets or 0) or 0))
	gui_util.set_text(prefix .. "_hp", hp_override ~= nil and hp_override or (player and (player.hp or 0) or 0))
	gui_util.set_alpha(prefix .. "_bullet_badge", alpha)
	gui_util.set_alpha(prefix .. "_bullets", alpha)
	gui_util.set_alpha(prefix .. "_hp_badge", alpha)
	gui_util.set_alpha(prefix .. "_hp", alpha)
end

local function set_portrait(prefix, player, side, hp_override, bullets_override, x_offset, entry_offset)
	local body_id = "combat_" .. prefix .. "_body"
	local status_alpha = player_status_alpha(player, hp_override)
	gui_util.set_texture(body_id, texture_name(player))
	gui_util.play_flipbook(body_id, player and (player.portrait_state or "front") or "front")
	gui_util.set_text("combat_" .. prefix .. "_name", player_name(player))
	gui_util.set_alpha("combat_" .. prefix .. "_name", 1.0)
	set_badges(prefix, player, hp_override, bullets_override, status_alpha)
	local x = side == "left" and -370.0 or 370.0
	gui_util.set_position(body_id, vmath.vector3(x + (x_offset or 0.0) + (entry_offset or 0.0), -30.0, 0.84))
	gui_util.set_alpha(body_id, status_alpha)
end

local function execution_step_seconds(resolution)
	if resolution and resolution.kind == "perfect_duel" then
		return PERFECT_DUEL_STEP_SECONDS
	end
	return ROULETTE_STEP_SECONDS
end

local function current_execution_step(self, resolution)
	local steps = resolution and resolution.steps or {}
	local step_seconds = execution_step_seconds(resolution)
	if #steps == 0 then
		return nil, 0, true, 1.0, step_seconds
	end

	if (self.execute_elapsed or 0.0) < EXECUTE_INTRO_SECONDS then
		return nil, 0, false, 0.0, step_seconds
	end

	local elapsed = math.max(0.0, (self.execute_elapsed or 0.0) - EXECUTE_INTRO_SECONDS)
	local raw_index = math.floor(elapsed / step_seconds) + 1
	local complete = raw_index > #steps
	local index = math.max(1, math.min(#steps, raw_index))
	local step_elapsed = complete and step_seconds or (elapsed - (index - 1) * step_seconds)
	return steps[index], index, complete, clamp01(step_elapsed / step_seconds), step_seconds
end

local function combat_pair(state, resolution, step)
	local left_id, right_id = duel_view.combat_pair_ids(state.duel, resolution, step)
	return player_by_id(state, left_id), left_id, player_by_id(state, right_id), right_id
end

local function hit_target_id(step)
	return step and (step.target_id or step.roulette_subject_id) or nil
end

local function visible_hp(player_id, player, base_player, resolution, step_index, step_progress, sequence_complete)
	local hp = base_player and base_player.hp or player and player.hp or 0
	for index, step in ipairs((resolution and resolution.steps) or {}) do
		if index > step_index and not sequence_complete then
			break
		end
		local applied = sequence_complete or index < step_index or step_progress >= HIT_APPLY_PROGRESS
		if applied and step.hit == true and hit_target_id(step) == player_id then
			hp = hp - 1
		end
	end
	return math.max(0, hp)
end

local function shake_offset(player_id, step, step_progress)
	if not step or step.hit ~= true or hit_target_id(step) ~= player_id then
		return 0.0
	end
	if step_progress < HIT_APPLY_PROGRESS or step_progress > 0.92 then
		return 0.0
	end
	local t = clamp01((step_progress - HIT_APPLY_PROGRESS) / 0.5)
	return math.sin(t * math.pi * 8.0) * 20.0 * (1.0 - t)
end

local function entry_offset(resolution, prefix, step_progress)
	if not resolution or resolution.kind ~= "perfect_duel" or prefix ~= "right" then
		return 0.0
	end
	local t = ease(clamp01(step_progress / 0.46))
	return 156.0 * (1.0 - t)
end

local function render_hit_flash(step, step_progress)
	local hit = step and step.hit == true and step_progress >= HIT_APPLY_PROGRESS
	local amount = hit and (1.0 - clamp01((step_progress - HIT_APPLY_PROGRESS) / 0.42)) or 0.0
	gui_util.set_enabled("hit_flash", amount > 0.02)
	gui_util.set_alpha("hit_flash", 0.42 * amount)
end

local function render_combat(self, state)
	local duel = state.duel or {}
	local resolution = duel.resolution or {}
	local step, step_index, sequence_complete, step_progress = current_execution_step(self, resolution)
	local left, left_id, right, right_id = combat_pair(state, resolution, step)
	local base_players = snapshot_by_id(duel)
	local left_hp = visible_hp(left_id, left, base_players[left_id], resolution, step_index, step_progress, sequence_complete)
	local right_hp = visible_hp(right_id, right, base_players[right_id], resolution, step_index, step_progress, sequence_complete)
	local left_bullets = duel_view.visible_bullets(
		left_id,
		left,
		base_players[left_id],
		resolution,
		step_index,
		step_progress,
		sequence_complete,
		HIT_APPLY_PROGRESS
	)
	local right_bullets = duel_view.visible_bullets(
		right_id,
		right,
		base_players[right_id],
		resolution,
		step_index,
		step_progress,
		sequence_complete,
		HIT_APPLY_PROGRESS
	)
	local audio_key = tostring(self.execute_key) .. ":" .. tostring(step_index)
	if step and step_progress >= HIT_APPLY_PROGRESS and self.last_execution_audio_key ~= audio_key then
		self.last_execution_audio_key = audio_key
		audio.play_sfx(step.hit == true and "bang" or "tick")
	end

	hide_reveal_nodes(self)
	set_nodes_enabled(COMBAT_NODE_IDS, true)
	set_portrait("left", left, "left", left_hp, left_bullets, shake_offset(left_id, step, step_progress), 0.0)
	set_portrait("right", right, "right", right_hp, right_bullets, shake_offset(right_id, step, step_progress), entry_offset(resolution, "right", step_progress))
	render_hit_flash(step, step_progress)

end

local function duel_key(state)
	local duel = state.duel or {}
	local bid = duel.bid or {}
	return table.concat({
		tostring(state.match.turn_count or 0),
		tostring(duel.challenger_id),
		tostring(duel.previous_bidder_id),
		tostring(bid.count),
		tostring(bid.face),
	}, ":")
end

local function reset_reveal_if_needed(self, state)
	local key = duel_key(state)
	if self.duel_key ~= key then
		self.duel_key = key
		self.reveal_elapsed = 0.0
		self.execute_elapsed = 0.0
	end
end

local function reset_execute_if_needed(self, state)
	local key = duel_key(state) .. ":execute"
	if self.execute_key ~= key then
		self.execute_key = key
		self.execute_elapsed = 0.0
		self.last_execution_audio_key = nil
	end
end

local function render_reveal(self, state)
	local order = alive_order(state)
	local layout = table_seat_layout.build(order, state.match.local_player_id, {
		arc_base_y = 84.0,
		arc_radius_x = 560.0,
		arc_radius_y = 176.0,
		local_cup_y = -118.0,
		local_character_y = -12.0,
	})
	local opponent_seats = opponent_seats_by_id(layout)
	local players = snapshot_by_id(state.duel)
	local round_index = state.turn and state.turn.round_index or 0

	set_nodes_enabled(REVEAL_NODE_IDS, true)
	hide_combat_nodes()
	gui_util.set_text("hint", all_revealed(self, order) and i18n.t("duel.reveal.hold") or i18n.t("duel.reveal.hint"))

	for index, player_id in ipairs(order) do
		local player = players[player_id] or state.players.by_id[player_id]
		local is_local = player_id == state.match.local_player_id
		local seat = is_local and layout.local_seat or opponent_seats[player_id]
		local progress = reveal_progress(self, index)
		if player and seat then
			render_player_cup(index, seat, is_local, progress)
			render_player_dice(self, index, player, seat, is_local, progress, round_index)
		else
			hide_player_slot(self, index)
		end
	end

	hide_unused_players(self, #order)
	local grid_count = render_grid(self, state, order, players)
	render_local_tray(self, state, players)
	visual_status.set("duel", {
		visible = true,
		mode = "reveal",
		player_count = #order,
		grid_count = grid_count,
		has_bid = state.duel and state.duel.bid ~= nil,
		has_judge = state.duel and state.duel.judge ~= nil,
		all_revealed = all_revealed(self, order),
		progression_owner = state.match and state.match.local_simulator and "flow_coordinator" or "server",
		active_player_id = state.turn and state.turn.active_player_id or nil,
		local_player_id = state.match and state.match.local_player_id or nil,
		is_local_active = state.turn and state.match and state.turn.active_player_id == state.match.local_player_id,
	})
end

local function render(self, state)
	local active = state.flow and state.flow.phase == "duel" and state.duel ~= nil
	gui_util.set_enabled("root", active)
	if not active then
		visual_status.set("duel", {
			visible = false,
			phase = state.flow and state.flow.phase or nil,
		})
		return
	end

	reset_reveal_if_needed(self, state)
	if state.duel.resolution then
		reset_execute_if_needed(self, state)
		visual_status.set("duel", {
			visible = true,
			mode = "combat",
			has_resolution = true,
			step_count = #(state.duel.resolution.steps or {}),
			progression_owner = state.match and state.match.local_simulator and "flow_coordinator" or "server",
		})
		render_combat(self, state)
	else
		render_reveal(self, state)
	end
end

local function request_render(self)
	self.needs_render = true
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end

	for _, topic in ipairs({ "duel", "turn", "players", "flow", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end

	render(self, self.store:get_state())
	return true
end

function init(self)
	self.store = nil
	self.subs = {}
	self.needs_render = false
	self.reveal_elapsed = 0.0
	self.execute_elapsed = 0.0
	self.duel_key = nil
	self.execute_key = nil
	self.last_execution_audio_key = nil
	gui.set_render_order(15)
	build_runtime_nodes(self)
	gui_util.set_enabled("root", false)

	bind_store(self)
end

function update(self, dt)
	self.reveal_elapsed = (self.reveal_elapsed or 0.0) + dt
	self.execute_elapsed = (self.execute_elapsed or 0.0) + dt
	bind_store(self)
	if self.needs_render and self.store then
		self.needs_render = false
	end
	if self.store then
		render(self, self.store:get_state())
	end
end

function on_message(self, message_id)
	bind_store(self)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	elseif message_id == hash("locale_changed") then
		request_render(self)
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
