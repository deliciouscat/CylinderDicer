local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local i18n = require("game.core.i18n")
local gui_util = require("ui.common.gui_util")
local visual_status = require("game.dev.visual_status")

local MAX_SLOTS = 6
local SKULL_HIT_SHAKE_SECONDS = 0.42
local SKULL_HIT_SHAKE_DISTANCE = 12.0
local SKULL_HIT_SHAKE_FREQUENCY = 72.0
local CENTER_PREVIOUS_SLOT = 3
local CENTER_ACTIVE_SLOT = 4
local FILL_SLOTS = { 1, 2, 5, 6, 3, 4 }
local TEXTURE_BY_SKIN = {
	["rosemund"] = "rosemund",
	["hush-feather"] = "hush_feather",
	["samuel-saber"] = "samuel_saber",
	["zippo-jay"] = "zippo_jay",
	["calamity-kate"] = "calamity_kate",
	["the-kid"] = "the_kid",
}
local VISIBLE_HUDS = {
	revolver_reload = true,
	bidding = true,
}

local function color(r, g, b, a)
	if vmath and vmath.vector4 then
		return vmath.vector4(r, g, b, a)
	end
	return {
		x = r,
		y = g,
		z = b,
		w = a,
	}
end

local function texture_name(player)
	return TEXTURE_BY_SKIN[player.skin] or TEXTURE_BY_SKIN[player.id] or "rosemund"
end

local function place_player(slots, assigned, slot_index, player_id)
	if not player_id or assigned[player_id] then
		return
	end
	slots[slot_index] = player_id
	assigned[player_id] = true
end

local function visual_slots(state)
	local slots = {}
	local assigned = {}
	local active_id = state.turn.active_player_id
	local previous_id = state.turn.previous_player_id

	if previous_id and previous_id ~= active_id then
		place_player(slots, assigned, CENTER_PREVIOUS_SLOT, previous_id)
	end
	place_player(slots, assigned, CENTER_ACTIVE_SLOT, active_id)

	local fill_index = 1
	for _, player_id in ipairs(state.players.order or {}) do
		if not assigned[player_id] then
			while fill_index <= #FILL_SLOTS and slots[FILL_SLOTS[fill_index]] do
				fill_index = fill_index + 1
			end
			if fill_index <= #FILL_SLOTS then
				place_player(slots, assigned, FILL_SLOTS[fill_index], player_id)
			end
		end
	end

	return slots
end

local function set_meta_enabled(prefix, visible)
	gui_util.set_enabled(prefix .. "_bullet_badge", visible)
	gui_util.set_enabled(prefix .. "_bullets", visible)
	gui_util.set_enabled(prefix .. "_hp_badge", visible)
	gui_util.set_enabled(prefix .. "_hp", visible)
	gui_util.set_enabled(prefix .. "_name", visible)
	gui_util.set_enabled(prefix .. "_marker", visible)
end

local function player_status_alpha(player)
	if player.eliminated == true or (player.hp or 0) <= 0 then
		return 0.5
	end
	return 1.0
end

local function set_status_alpha(prefix, alpha)
	gui_util.set_alpha(prefix .. "_bullet_badge", alpha)
	gui_util.set_alpha(prefix .. "_bullets", alpha)
	gui_util.set_alpha(prefix .. "_hp_badge", alpha)
	gui_util.set_alpha(prefix .. "_hp", alpha)
end

local function set_slot(index, player, focus, show_meta)
	local prefix = "slot" .. tostring(index)
	local visible = player ~= nil

	gui_util.set_enabled(prefix .. "_body", visible)
	set_meta_enabled(prefix, visible and show_meta)

	if not player then
		return
	end

	gui_util.set_text(prefix .. "_bullets", selectors.player_bullets(player))
	gui_util.set_text(prefix .. "_hp", player.hp or 0)
	gui_util.set_text(prefix .. "_name", player.name or player.id)
	if focus.active then
		gui_util.set_text(prefix .. "_marker", player.is_local
			and i18n.t("player.marker.mine")
			or i18n.t("player.marker.active"))
	elseif focus.previous then
		gui_util.set_text(prefix .. "_marker", i18n.t("player.marker.previous"))
	else
		gui_util.set_text(prefix .. "_marker", "")
	end

	gui_util.set_texture(prefix .. "_body", texture_name(player))
	gui_util.set_color(prefix .. "_body", color(1.0, 1.0, 1.0, 1.0))
	local status_alpha = player_status_alpha(player)
	gui_util.set_alpha(prefix .. "_body", status_alpha)
	set_status_alpha(prefix, status_alpha)
	gui_util.play_flipbook(prefix .. "_body", player.portrait_state or "front")
end

local function restore_body(self, index)
	local defaults = self.body_defaults[index]
	if not defaults then
		return
	end
	local id = "slot" .. tostring(index) .. "_body"
	gui_util.set_position(id, defaults.position)
	gui_util.set_scale(id, defaults.scale)
	gui_util.set_size(id, defaults.size)
end

local function render_standard(self, state)
	local slots = visual_slots(state)
	self.slot_player_ids = slots

	for index = 1, MAX_SLOTS do
		restore_body(self, index)
		local player_id = slots[index]
		local player = player_id and state.players.by_id[player_id] or nil
		set_slot(index, player, {
			active = player_id == state.turn.active_player_id,
			previous = player_id == state.turn.previous_player_id,
		}, true)
	end
end

local function update_skull_hit_shake(self, dt)
	if (self.skull_hit_shake_remaining or 0.0) <= 0.0 then
		return
	end

	self.skull_hit_shake_remaining = math.max(0.0, self.skull_hit_shake_remaining - dt)
	local elapsed = SKULL_HIT_SHAKE_SECONDS - self.skull_hit_shake_remaining
	local strength = self.skull_hit_shake_remaining / SKULL_HIT_SHAKE_SECONDS
	local offset = math.sin(elapsed * SKULL_HIT_SHAKE_FREQUENCY)
		* SKULL_HIT_SHAKE_DISTANCE
		* strength

	for index, player_id in pairs(self.slot_player_ids or {}) do
		if player_id == self.skull_hit_player_id then
			local defaults = self.body_defaults[index]
			if defaults then
				gui_util.set_position(
					"slot" .. tostring(index) .. "_body",
					vmath.vector3(defaults.position.x + offset, defaults.position.y, defaults.position.z)
				)
			end
			break
		end
	end

	if self.skull_hit_shake_remaining <= 0.0 then
		self.skull_hit_player_id = nil
	end
end

local function render(self, state)
	local phase = selectors.phase(state)
	local hud = selectors.hud_kind(state)
	local visible = VISIBLE_HUDS[hud] == true
	local skull_roulette = state.bidding and state.bidding.skull_roulette
	if skull_roulette and skull_roulette.sequence ~= self.last_skull_roulette_sequence then
		self.last_skull_roulette_sequence = skull_roulette.sequence
		if skull_roulette.hit == true then
			self.skull_hit_player_id = skull_roulette.player_id
			self.skull_hit_shake_remaining = SKULL_HIT_SHAKE_SECONDS
		end
	end
	gui_util.set_enabled("root", visible)
	if visible then
		render_standard(self, state)
	end

	local active_slot = nil
	local active_position_x = nil
	if visible then
		for index, player_id in pairs(self.slot_player_ids or {}) do
			if player_id == state.turn.active_player_id then
				active_slot = index
				local active_body = gui_util.node("slot" .. tostring(index) .. "_body")
				if active_body then
					active_position_x = gui.get_position(active_body).x
				end
				break
			end
		end
	end

	visual_status.set("player_carousel", {
		phase = phase,
		hud = hud,
		visible = visible,
		mode = "standard",
		players = #(state.players.order or {}),
		active_player_id = state.turn.active_player_id,
		active_slot = active_slot,
		active_position_x = active_position_x,
	})
end

local function request_render(self)
	self.needs_render = true
end

local function cache_body_defaults(self)
	self.body_defaults = {}
	for index = 1, MAX_SLOTS do
		local node = gui_util.node("slot" .. tostring(index) .. "_body")
		if node then
			self.body_defaults[index] = {
				position = gui.get_position(node),
				scale = gui.get_scale(node),
				size = gui.get_size(node),
			}
		end
	end
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end

	for _, topic in ipairs({ "players", "turn", "bidding", "flow", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end

	render(self, self.store:get_state())
	return true
end

function init(self)
	self.store = nil
	self.subs = {}
	self.needs_render = false
	self.slot_player_ids = {}
	self.last_skull_roulette_sequence = nil
	self.skull_hit_player_id = nil
	self.skull_hit_shake_remaining = 0.0
	gui.set_render_order(3)
	gui_util.set_enabled("root", false)
	cache_body_defaults(self)

	bind_store(self)
end

function update(self, dt)
	if not self.store and not bind_store(self) then
		return
	end
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
	update_skull_hit_shake(self, dt)
end

function on_message(self, message_id)
	bind_store(self)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	elseif message_id == hash("locale_changed") then
		request_render(self)
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
