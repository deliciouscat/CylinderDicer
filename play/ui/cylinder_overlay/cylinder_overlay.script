local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local actions = require("game.model.actions")
local anchors = require("game.core.anchors")
local tween = require("game.core.tween")
local slot_geometry = require("ui.cylinder_overlay.slot_geometry")
local local_permissions = require("ui.common.local_permissions")

local SLOT_COUNT = 6
local SLOT_CENTER = {
	focal = {
		x = 640,
		y = 372,
		radius = 245,
	},
	hud = {
		x = 1140,
		y = 115,
		radius = 105,
	},
}

local function post_state(self, state)
	if not self.store then
		return
	end

	local local_player = selectors.local_player(state)
	local pending = state.pending_load
	local player = local_player

	if not player then
		return
	end

	self.load_player_id = player.id
	self.can_load = local_permissions.can_load(state)
	self.loaded_slots = {}
	for i, slot in ipairs(player.cylinder.slots or {}) do
		self.loaded_slots[i] = slot.loaded == true
	end
end

local function bind_store(self)
	if self.store then
		return true
	end

	self.store = store_mod.get()
	if not self.store then
		return false
	end

	self.subs[#self.subs + 1] = self.store:subscribe("players", function(state)
		post_state(self, state)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("turn", function(state)
		post_state(self, state)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("ui", function(state)
		post_state(self, state)
	end)

	post_state(self, self.store:get_state())
	return true
end

local function hit_slot(self, action)
	if action.touch and action.touch[1] then
		action = action.touch[1]
	end

	if action.slot_index then
		return action.slot_index
	end

	if not action.x or not action.y then
		return nil
	end

	local center = SLOT_CENTER[self.target] or SLOT_CENTER.focal
	return slot_geometry.slot_at(
		action.x,
		action.y,
		center.x,
		center.y,
		center.radius,
		SLOT_COUNT
	)
end

function init(self)
	self.store = nil
	self.subs = {}
	self.can_load = false
	self.load_player_id = nil
	self.loaded_slots = {}
	self.target = "offscreen"
	msg.post(".", "acquire_input_focus")

	bind_store(self)
end

function update(self, dt)
	if not self.store then
		bind_store(self)
	end
end

function on_message(self, message_id, message)
	bind_store(self)

	if message_id == hash("set_target") then
		self.target = message.anchor or "offscreen"
		tween.to(".", "position", anchors.resolve(self.target), 0.4, go.EASING_INOUTQUAD)
		if self.store then
			post_state(self, self.store:get_state())
		end
	elseif message_id == hash("activate") then
		msg.post(".", "enable")
	elseif message_id == hash("deactivate") then
		msg.post(".", "disable")
	end
end

function on_input(self, action_id, action)
	bind_store(self)

	if not self.can_load or not action.pressed then
		return
	end

	local slot_index = hit_slot(self, action)
	if not slot_index or self.loaded_slots[slot_index] then
		print("[cylinder]", "load rejected", "slot=" .. tostring(slot_index), "target=" .. tostring(self.target))
		return
	end

	local result = self.store:dispatch(actions.bullet_load(slot_index, self.load_player_id))
	if result and result.ok then
		print("[cylinder]", "loaded", "slot=" .. tostring(slot_index), "player=" .. tostring(self.load_player_id))
	else
		print("[cylinder]", "load failed", "slot=" .. tostring(slot_index), "error=" .. tostring(result and result.error))
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
