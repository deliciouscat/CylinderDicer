local store_mod = require("game.model.store")
local i18n = require("game.core.i18n")
local gui_util = require("ui.common.gui_util")
local result_view = require("ui.result.result_view")
local visual_status = require("game.dev.visual_status")
local actions = require("game.model.actions")
local bridge = require("main.game_bridge")

local DIGIT_HEIGHT = 58
local DIGIT_PLACES = { 10000, 1000, 100, 10, 1 }

local function title_key(place)
	if place == 1 then
		return "result.victory"
	end
	return "result.place." .. tostring(place)
end

local function plaque_for_place(place)
	if place == 1 then
		return "rank_1", vmath.vector3(610, 360, 0)
	end
	if place <= 3 then
		return "rank_2_3", vmath.vector3(760, 432, 0)
	end
	return "rank_4_6", vmath.vector3(760, 432, 0)
end

local function set_digit_column(index, value, direction)
	local current, next_digit, offset = result_view.digit_frame(value, DIGIT_PLACES[index], direction)
	local current_node = gui.get_node("digit_" .. index .. "_current")
	local next_node = gui.get_node("digit_" .. index .. "_next")
	gui.set_text(current_node, tostring(current))
	gui.set_text(next_node, tostring(next_digit))
	if direction >= 0 then
		gui.set_position(current_node, vmath.vector3(0, offset * DIGIT_HEIGHT, 0.2))
		gui.set_position(next_node, vmath.vector3(0, (offset - 1) * DIGIT_HEIGHT, 0.2))
	else
		gui.set_position(current_node, vmath.vector3(0, -offset * DIGIT_HEIGHT, 0.2))
		gui.set_position(next_node, vmath.vector3(0, (1 - offset) * DIGIT_HEIGHT, 0.2))
	end
end

local function set_settled_digit(index, value)
	local place_value = DIGIT_PLACES[index]
	local digit = math.floor(math.max(0, value) / place_value) % 10
	local current_node = gui.get_node("digit_" .. index .. "_current")
	local next_node = gui.get_node("digit_" .. index .. "_next")
	gui.set_text(current_node, tostring(digit))
	gui.set_text(next_node, tostring(digit))
	gui.set_position(current_node, vmath.vector3(0, 0, 0.2))
	gui.set_position(next_node, vmath.vector3(0, -DIGIT_HEIGHT, 0.2))
end

local function set_odometer(value, direction, settled)
	for index = 1, #DIGIT_PLACES do
		if settled then
			set_settled_digit(index, value)
		else
			set_digit_column(index, value, direction)
		end
	end
end

local function configure_digit_columns(before, after)
	local maximum = math.max(math.abs(before or 0), math.abs(after or 0))
	local digits = math.max(4, math.min(5, #tostring(math.floor(maximum))))
	local first_index = 6 - digits
	local visible_index = 0
	for index = 1, #DIGIT_PLACES do
		local visible = index >= first_index
		gui.set_enabled(gui.get_node("digit_" .. index .. "_clip"), visible)
		if visible then
			visible_index = visible_index + 1
			local x = (visible_index - (digits + 1) / 2) * 44
			gui.set_position(gui.get_node("digit_" .. index .. "_clip"), vmath.vector3(x, 0, 0.1))
		end
	end
end

local function position_content(place, match_complete)
	local victory = place == 1
	gui.set_position(gui.get_node("title"), vmath.vector3(0, victory and 0 or 58, 0.2))
	gui.set_position(gui.get_node("congratulations"), vmath.vector3(0, victory and -27 or 20, 0.2))
	gui.set_position(gui.get_node("rating_label"), vmath.vector3(0, victory and -52 or -17, 0.2))
	gui.set_position(gui.get_node("odometer"), vmath.vector3(0, victory and -91 or -67, 0.2))
	gui.set_position(gui.get_node("rating_delta"), vmath.vector3(-175, victory and -91 or -67, 0.2))
	gui.set_position(gui.get_node("unrated"), vmath.vector3(0, victory and -91 or -68, 0.2))
	local button_y = victory and -159 or -148
	gui.set_position(gui.get_node("lobby_button"), match_complete
		and vmath.vector3(0, button_y, 0.3)
		or vmath.vector3(-112, button_y, 0.3))
	gui.set_position(gui.get_node("spectate_button"), vmath.vector3(112, button_y, 0.3))
end

local function render_static(self, state)
	local placement, result = result_view.local_result(state)
	self.place = math.max(1, math.min(6, tonumber(placement.place) or 1))
	self.rated = placement.rated == true and result.rated == true
	self.mmr_before = tonumber(placement.mmr_before or placement.mmrBefore)
	self.mmr_after = tonumber(placement.mmr_after or placement.mmrAfter)
	self.mmr_delta = tonumber(placement.mmr_delta or placement.mmrDelta)
	self.elapsed = 0
	self.match_complete = state.match.status == "complete"

	local plaque, plaque_size = plaque_for_place(self.place)
	gui.play_flipbook(gui.get_node("plaque"), plaque)
	gui.set_size(gui.get_node("plaque"), plaque_size)
	gui_util.set_text("title", i18n.t(title_key(self.place)))
	gui_util.set_text("congratulations", self.place == 1 and i18n.t("result.congratulations") or "")
	gui_util.set_text("rating_label", i18n.t("result.rating"))
	gui_util.set_enabled("odometer", self.rated)
	gui_util.set_enabled("rating_delta", self.rated)
	gui_util.set_enabled("unrated", not self.rated)
	gui_util.set_text("unrated", state.match.mode == "ranked" and not self.match_complete
		and i18n.t("result.rating_pending")
		or i18n.t("result.unrated"))
	gui_util.set_enabled("spectate_button", not self.match_complete)
	gui_util.set_enabled("spectate_label", not self.match_complete)
	gui_util.set_text("spectate_label", i18n.t("result.spectate"))
	gui_util.set_text("lobby_label", i18n.t("result.lobby"))
	position_content(self.place, self.match_complete)

	if self.rated and self.mmr_before and self.mmr_after then
		self.direction = self.mmr_after >= self.mmr_before and 1 or -1
		self.reel_duration = result_view.reel_duration(self.mmr_after - self.mmr_before)
		configure_digit_columns(self.mmr_before, self.mmr_after)
		set_odometer(self.mmr_before, self.direction, true)
		gui_util.set_text("rating_delta", string.format("%+d", self.mmr_delta or (self.mmr_after - self.mmr_before)))
	else
		self.direction = 1
		self.reel_duration = 0
	end
end

local function request_render(self)
	self.needs_render = true
end

local function handle_pointer(self, x, y)
	if not gui.is_enabled(gui.get_node("root")) then
		return false
	end
	if gui_util.pick("lobby_button", x, y) then
		if not self.exit_requested then
			self.exit_requested = true
			bridge.emit("EXIT_TO_LOBBY", {
				match_id = self.store and self.store:get_state().match.match_id,
				reason = "result",
			})
		end
		return true
	end
	if not self.match_complete and gui_util.pick("spectate_button", x, y) then
		self.store:dispatch(actions.result_spectate())
		return true
	end
	return true
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end
	for _, topic in ipairs({ "match", "players", "flow", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end
	render_static(self, self.store:get_state())
	return true
end

local function update_status(self, score, complete)
	visual_status.set("result", {
		visible = gui.is_enabled(gui.get_node("root")),
		place = self.place,
		rated = self.rated,
		mmr_before = self.mmr_before,
		mmr_after = self.mmr_after,
		mmr_delta = self.mmr_delta,
		displayed_score = math.floor((score or 0) + 0.5),
		reel_duration = self.reel_duration,
		reel_complete = complete == true,
	})
end

function init(self)
	self.store = nil
	self.subs = {}
	self.needs_render = false
	self.elapsed = 0
	self.rated = false
	self.exit_requested = false
	gui.set_render_order(30)
	gui_util.set_enabled("root", false)
	bind_store(self)
end

function update(self, dt)
	if not self.store and not bind_store(self) then
		return
	end
	if self.needs_render then
		self.needs_render = false
		render_static(self, self.store:get_state())
	end
	if self.rated and self.mmr_before and self.mmr_after then
		self.elapsed = self.elapsed + dt
		local score, complete = result_view.score_at(self.elapsed, self.mmr_before, self.mmr_after)
		set_odometer(complete and self.mmr_after or score, self.direction, complete)
		update_status(self, score, complete)
	else
		update_status(self, 0, true)
	end
end

function on_message(self, message_id, message)
	bind_store(self)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		self.exit_requested = false
		render_static(self, self.store:get_state())
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
		visual_status.set("result", { visible = false })
	elseif message_id == hash("locale_changed") then
		request_render(self)
	elseif message_id == hash("pointer_input") then
		handle_pointer(self, message.x, message.y)
	end
end

function on_input(self, action_id, action)
	if not action.pressed or (action_id ~= hash("pointer") and action_id ~= hash("touch")) then
		return false
	end
	return handle_pointer(self, action.x, action.y)
end

function final(self)
	visual_status.clear("result")
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
