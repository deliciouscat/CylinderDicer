local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local i18n = require("game.core.i18n")
local gui_util = require("ui.common.gui_util")

local function label_for_state(self, state)
	local phase = selectors.phase(state)
	local hud = selectors.hud_kind(state)
	if hud == "revolver_reload" then
		if state.bidding and state.bidding.reload_gate and selectors.is_local_pending_load(state) then
			return i18n.t("turn.reload_countdown", {
				seconds = math.max(0, math.ceil(self.reload_countdown or 0)),
			})
		end
		if not selectors.is_local_pending_load(state) then
			local pending = state.pending_load
			local player = pending and state.players.by_id[pending.player_id]
			return i18n.t("turn.loading", {
				name = player and (player.name or player.id) or i18n.t("turn.opponent"),
			})
		end
		return i18n.t("turn.reload")
	end
	if hud == "loading" then
		local pending = state.pending_load
		local player = pending and state.players.by_id[pending.player_id]
		return i18n.t("turn.loading", {
			name = player and (player.name or player.id) or i18n.t("turn.opponent"),
		})
	end
	if phase == "cup_shake" or phase == "dice_check" or phase == "bidding_gap" then
		return i18n.t("turn.shake")
	end
	if phase == "bidding" then
		if selectors.is_my_turn(state) then
			return i18n.t("turn.mine")
		end
		local player = state.players.by_id[state.turn.active_player_id]
		return player and (player.name or player.id) or i18n.t("turn.opponent")
	end
	if phase == "duel" then
		return i18n.t("turn.duel")
	end
	return i18n.t("hud.hint.complete")
end

local function render(self, state)
	local gate = state.bidding and state.bidding.reload_gate
	if gate and gate.epoch ~= self.reload_gate_epoch then
		self.reload_gate_epoch = gate.epoch
		self.reload_countdown = gate.countdown_seconds or 3
	elseif not gate then
		self.reload_gate_epoch = nil
		self.reload_countdown = nil
	end
	gui_util.set_text("label", label_for_state(self, state))
end

local function request_render(self)
	self.needs_render = true
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end

	for _, topic in ipairs({ "turn", "players", "flow", "bidding", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end

	render(self, self.store:get_state())
	return true
end

function init(self)
	self.store = nil
	self.subs = {}
	self.needs_render = false
	self.reload_gate_epoch = nil
	self.reload_countdown = nil
	gui.set_render_order(6)

	bind_store(self)
end

function update(self, dt)
	if not self.store and not bind_store(self) then
		return
	end
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
	if self.reload_countdown and self.reload_countdown > 0 and self.store then
		self.reload_countdown = math.max(0, self.reload_countdown - dt)
		gui_util.set_text("label", label_for_state(self, self.store:get_state()))
	end
end

function on_message(self, message_id)
	bind_store(self)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	elseif message_id == hash("locale_changed") then
		request_render(self)
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
