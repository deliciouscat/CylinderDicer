local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local i18n = require("game.core.i18n")
local gui_util = require("ui.common.gui_util")

local function label_for_state(state)
	local phase = selectors.phase(state)
	if phase == "revolver_reload" then
		if not selectors.is_local_pending_load(state) then
			local pending = state.pending_load
			local player = pending and state.players.by_id[pending.player_id]
			return i18n.t("turn.loading", {
				name = player and (player.name or player.id) or i18n.t("turn.opponent"),
			})
		end
		return i18n.t("turn.reload")
	end
	if phase == "cup_shake" or phase == "dice_check" or phase == "bidding_gap" then
		return i18n.t("turn.shake")
	end
	if phase == "bidding" then
		if selectors.is_my_turn(state) then
			return i18n.t("turn.mine")
		end
		local player = state.players.by_id[state.turn.active_player_id]
		return player and (player.name or player.id) or i18n.t("turn.opponent")
	end
	if phase == "duel" then
		return i18n.t("turn.duel")
	end
	return i18n.t("hud.hint.complete")
end

local function render(self, state)
	gui_util.set_text("label", label_for_state(state))
end

local function request_render(self)
	self.needs_render = true
end

function init(self)
	self.store = store_mod.get()
	self.subs = {}
	self.needs_render = false
	gui.set_render_order(6)

	if not self.store then
		return
	end

	self.subs[#self.subs + 1] = self.store:subscribe("turn", function(_state)
		request_render(self)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("players", function(_state)
		request_render(self)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("ui", function(_state)
		request_render(self)
	end)

	render(self, self.store:get_state())
end

function update(self, dt)
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
end

function on_message(self, message_id)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	end
end

function final(self)
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
