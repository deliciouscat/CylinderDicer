local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local actions = require("game.model.actions")
local gestures = require("game.core.gestures")
local gui_util = require("ui.common.gui_util")
local local_permissions = require("ui.common.local_permissions")
local rail_layout = require("ui.rail.rail_layout")
local visual_status = require("game.dev.visual_status")

local PIXELS_PER_COUNT = 32
local STRIP_X_PROPERTY = "position.x"
local CENTER_TEXT_COLOR = vmath.vector4(1.0, 0.93, 0.68, 1.0)
local DEFAULT_TEXT_COLOR = vmath.vector4(0.72, 0.72, 0.72, 1.0)

local animate_to_target

local function reset_strip(self)
	gui.set_position(self.rail_strip, vmath.vector3(0.0, 0.0, 0.0))
end

local function render_cells(center_count)
	for index = 1, rail_layout.CELL_COUNT do
		local value = rail_layout.value_for_index(center_count, index)
		gui_util.set_enabled("cell_" .. tostring(index) .. "_panel", value ~= nil)
		gui_util.set_text("cell_" .. tostring(index), value or "")
		gui_util.set_color(
			"cell_" .. tostring(index),
			index == rail_layout.CENTER_INDEX and CENTER_TEXT_COLOR or DEFAULT_TEXT_COLOR
		)
	end
end

local function snap_to_count(self, count)
	self.is_animating = false
	self.displayed_count = count
	self.target_count = count
	reset_strip(self)
	render_cells(count)
end

animate_to_target = function(self)
	if self.is_animating or not self.is_visible or not self.displayed_count or not self.target_count then
		return
	end

	local delta = self.target_count - self.displayed_count
	if math.abs(delta) > rail_layout.MAX_ANIMATED_STEP then
		self.displayed_count = self.target_count - (delta > 0 and 1 or -1)
		reset_strip(self)
		render_cells(self.displayed_count)
	end

	local step = rail_layout.step_to_target(self.displayed_count, self.target_count)
	if step == 0 then
		return
	end

	self.is_animating = true
	gui.animate(
		self.rail_strip,
		STRIP_X_PROPERTY,
		-step * rail_layout.CELL_SPACING,
		gui.EASING_INOUTQUAD,
		rail_layout.animation_duration(step),
		0.0,
		function()
			self.displayed_count = self.displayed_count + step
			self.is_animating = false
			reset_strip(self)
			render_cells(self.displayed_count)
			if self.is_visible then
				animate_to_target(self)
			else
				snap_to_count(self, self.target_count)
			end
		end
	)
end

local function render(self, state)
	local bid = state.bidding.my_bid
	local current = state.bidding.current_bid
	local visible = selectors.is_hud(state, "bidding")
	local target_count = bid.count
	local half = rail_layout.CENTER_INDEX - 1

	visual_status.set("rail", {
		phase = selectors.phase(state),
		hud = selectors.hud_kind(state),
		visible = visible,
		lo = math.max(rail_layout.MIN_COUNT, target_count - half),
		hi = math.min(rail_layout.MAX_COUNT, target_count + half),
		selected_count = target_count,
		current_bid = current,
	})
	gui_util.set_enabled("root", visible)
	self.is_visible = visible

	if not self.displayed_count or (not visible and not self.is_animating) then
		snap_to_count(self, target_count)
	else
		self.target_count = target_count
		animate_to_target(self)
	end

	if current then
		gui_util.set_text("current_bid", ("%s: %d x %d"):format(
			current.player_id,
			current.count,
			current.face
		))
	else
		gui_util.set_text("current_bid", "-")
	end
end

local function request_render(self)
	self.needs_render = true
end

local function select_delta(self, delta)
	local state = self.store:get_state()
	if not local_permissions.can_bid(state) or delta == 0 then
		return
	end
	local next_count = state.bidding.my_bid.count + delta
	self.store:dispatch(actions.bid_select_count(next_count))
end

local function bind_store(self)
	if self.store then
		return true
	end
	self.store = store_mod.get()
	if not self.store then
		return false
	end

	for _, topic in ipairs({ "bidding", "turn", "flow", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_render(self)
		end)
	end

	render(self, self.store:get_state())
	return true
end

function init(self)
	self.store = nil
	self.gesture = gestures.new(nil)
	self.subs = {}
	self.needs_render = false
	self.rail_strip = gui.get_node("rail_strip")
	self.displayed_count = nil
	self.target_count = nil
	self.is_animating = false
	self.is_visible = false
	if gui and gui.set_render_order then
		gui.set_render_order(7)
	end
	gui_util.acquire_input_focus()
	gui_util.set_enabled("root", false)

	bind_store(self)
end

function update(self, dt)
	if not self.store and not bind_store(self) then
		return
	end
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
end

function on_message(self, message_id, message)
	bind_store(self)
	if message_id == hash("activate") then
		gui_util.set_enabled("root", true)
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	elseif message_id == hash("select_count") and message.count then
		local state = self.store and self.store:get_state()
		if state and local_permissions.can_bid(state) then
			self.store:dispatch(actions.bid_select_count(message.count))
		end
	elseif message_id == hash("locale_changed") then
		request_render(self)
	end
end

function on_input(self, action_id, action)
	if not self.store and not bind_store(self) then
		return
	end

	local state = self.store:get_state()
	if not local_permissions.can_bid(state) then
		return
	end

	local event = self.gesture:feed(action_id, action)
	if not event then
		return
	end

	if event.kind == "drag" then
		select_delta(self, math.floor((event.dx or 0) / PIXELS_PER_COUNT))
	elseif event.kind == "scroll" then
		select_delta(self, event.amount > 0 and 1 or -1)
	elseif event.kind == "key_left" then
		select_delta(self, -1)
	elseif event.kind == "key_right" then
		select_delta(self, 1)
	end
end

function final(self)
	gui_util.release_input_focus()
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
