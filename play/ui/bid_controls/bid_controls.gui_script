local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")
local actions = require("game.model.actions")
local audio = require("game.core.audio")
local i18n = require("game.core.i18n")
local gui_util = require("ui.common.gui_util")
local local_permissions = require("ui.common.local_permissions")

local ACTION_FACE_UP = hash("face_up")
local ACTION_FACE_DOWN = hash("face_down")
local ACTION_PASS = hash("pass")
local ACTION_CHALLENGE = hash("challenge")
local ACTION_POINTER = hash("pointer")
local ACTION_TOUCH = hash("touch")

local function render(self, state)
	local bid = state.bidding.my_bid
	self.can_drive = local_permissions.can_bid(state)
	self.can_pass = self.can_drive and selectors.is_my_bid_valid(state)
	self.can_challenge = self.can_drive and selectors.has_previous_bid(state)

	gui_util.set_enabled("root", self.can_drive)
	gui_util.set_text("pass_label", i18n.t("action.pass"))
	gui_util.set_text("challenge_label", i18n.t("action.challenge"))
	gui_util.set_text("bid_value", bid.face)
	gui_util.set_text("face_hint", i18n.t("bid.count_face", {
		count = bid.count,
		face = bid.face,
	}))
	gui_util.set_text("pass_enabled", self.can_pass and "enabled" or "disabled")
	gui_util.set_text("challenge_enabled", self.can_challenge and "enabled" or "disabled")
end

local function request_render(self)
	self.needs_render = true
end

local function handle_command(self, command)
	if not self.store then
		return
	end

	local state = self.store:get_state()
	local bid = state.bidding.my_bid

	if not self.can_drive then
		audio.play_sfx("click_empty")
		return
	end

	if command == "face_up" then
		self.store:dispatch(actions.bid_select_face(bid.face + 1))
	elseif command == "face_down" then
		self.store:dispatch(actions.bid_select_face(bid.face - 1))
	elseif command == "pass" and self.can_pass then
		audio.play_sfx("click")
		self.store:dispatch(actions.bid_raise({
			player_id = state.turn.active_player_id,
			count = bid.count,
			face = bid.face,
		}))
	elseif command == "challenge" and self.can_challenge then
		audio.play_sfx("click")
		self.store:dispatch(actions.bid_challenge())
	else
		audio.play_sfx("click_empty")
	end
end

local function pointer_position(action)
	if action.touch and action.touch[1] then
		action = action.touch[1]
	end
	if action.x and action.y then
		return action.x, action.y
	end
	return nil, nil
end

local function handle_pointer(self, action)
	local x, y = pointer_position(action)
	if not x then
		return false
	end

	if gui_util.pick("pass_button", x, y) then
		handle_command(self, "pass")
		return true
	elseif gui_util.pick("challenge_button", x, y) then
		handle_command(self, "challenge")
		return true
	elseif gui_util.pick("face_up", x, y) then
		handle_command(self, "face_up")
		return true
	elseif gui_util.pick("face_down", x, y) then
		handle_command(self, "face_down")
		return true
	end

	return false
end

function init(self)
	self.store = store_mod.get()
	self.subs = {}
	self.can_drive = false
	self.can_pass = false
	self.can_challenge = false
	self.needs_render = false
	if gui and gui.set_render_order then
		gui.set_render_order(8)
	end
	gui_util.acquire_input_focus()

	if not self.store then
		return
	end

	self.subs[#self.subs + 1] = self.store:subscribe("bidding", function(_state)
		request_render(self)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("turn", function(_state)
		request_render(self)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("ui", function(_state)
		request_render(self)
	end)

	render(self, self.store:get_state())
end

function update(self, dt)
	if self.needs_render and self.store then
		self.needs_render = false
		render(self, self.store:get_state())
	end
end

function on_message(self, message_id, message)
	if message_id == hash("activate") then
		request_render(self)
	elseif message_id == hash("deactivate") then
		gui_util.set_enabled("root", false)
	elseif message_id == hash("command") then
		handle_command(self, message.command)
	end
end

function on_input(self, action_id, action)
	if not action.pressed then
		return
	end

	if action_id == ACTION_POINTER or action_id == ACTION_TOUCH then
		handle_pointer(self, action)
	elseif action_id == ACTION_FACE_UP then
		handle_command(self, "face_up")
	elseif action_id == ACTION_FACE_DOWN then
		handle_command(self, "face_down")
	elseif action_id == ACTION_PASS then
		handle_command(self, "pass")
	elseif action_id == ACTION_CHALLENGE then
		handle_command(self, "challenge")
	end
end

function on_reload(self)
	if self.store then
		request_render(self)
	end
end

function final(self)
	gui_util.release_input_focus()
	if self.store then
		for _, token in ipairs(self.subs or {}) do
			self.store:unsubscribe(token)
		end
	end
end
