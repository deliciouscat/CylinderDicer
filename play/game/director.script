local store_mod = require("game.model.store")
local presentation = require("game.presentation")

local function sync_signature(state)
	if not state then
		return "none"
	end

	local view = presentation.describe(state)
	return table.concat({ view.hud or "-", view.background or "-", view.cylinder_anchor or "-" }, "|")
end

local function set_block(self, view)
	if self.active_kind ~= view.hud then
		for _, url in ipairs(presentation.all_components()) do
			msg.post(url, "deactivate")
		end
		self.active_kind = view.hud
	end

	for _, url in ipairs(view.components) do
		msg.post(url, "activate")
	end

	msg.post("/ui#turn_indicator", "activate")
end

local function sync_turn(self, state)
	local view = presentation.describe(state)
	set_block(self, view)
	self.sync_signature = sync_signature(state)

	msg.post("/background#background", "pan_to", {
		location = view.background,
	})

	msg.post("/cylinder#cylinder", "set_target", {
		anchor = view.cylinder_anchor,
	})
end

local function request_turn_sync(self)
	self.needs_turn_sync = true
end

local function bind_store(self)
	self.store = store_mod.get()
	self.subs = {}

	if not self.store then
		return false
	end

	for _, topic in ipairs({ "match", "players", "turn", "flow", "ui" }) do
		self.subs[#self.subs + 1] = self.store:subscribe(topic, function(_state)
			request_turn_sync(self)
		end)
	end

	sync_turn(self, self.store:get_state())
	self.needs_turn_sync = false
	return true
end

function init(self)
	self.store = nil
	self.subs = {}
	self.active_kind = nil
	self.needs_turn_sync = false
	self.sync_signature = nil

	bind_store(self)
end

function update(self, dt)
	if not self.store then
		bind_store(self)
		return
	end

	local state = self.store:get_state()
	if self.needs_turn_sync or sync_signature(state) ~= self.sync_signature then
		self.needs_turn_sync = false
		sync_turn(self, state)
	end
end

function on_message(self, message_id, message)
	if message_id == hash("boot") and not self.store then
		bind_store(self)
	elseif message_id == hash("boot") and self.store then
		sync_turn(self, self.store:get_state())
		self.needs_turn_sync = false
	elseif message_id == hash("background_pan_complete") then
		self.last_background_location = message.location
	end
end

function final(self)
	if self.store and self.subs then
		for _, token in ipairs(self.subs) do
			self.store:unsubscribe(token)
		end
	end
end
