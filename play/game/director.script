local store_mod = require("game.model.store")
local selectors = require("game.model.selectors")

local ALL_BLOCKS = {
	"/ui#shake",
	"/ui#player_carousel",
	"/ui#rail",
	"/ui#local_hud",
	"/ui#bid_controls",
	"/ui#duel",
}

local BLOCKS = {
	revolver_reload = {
		"/ui#player_carousel",
	},
	cup_shake = {
		"/ui#shake",
		"/ui#player_carousel",
	},
	bidding = {
		"/ui#player_carousel",
		"/ui#rail",
		"/ui#local_hud",
		"/ui#bid_controls",
	},
	duel = {
		"/ui#player_carousel",
		"/ui#duel",
	},
	complete = {
		"/ui#duel",
	},
}

local function set_block(self, kind)
	if self.active_kind ~= kind then
		for _, url in ipairs(ALL_BLOCKS) do
			msg.post(url, "deactivate")
		end
		self.active_kind = kind
	end

	for _, url in ipairs(BLOCKS[kind] or {}) do
		msg.post(url, "activate")
	end

	msg.post("/ui#turn_indicator", "activate")
end

local function sync_turn(self, state)
	local kind = selectors.hud_kind(state)
	set_block(self, kind)

	msg.post("/background#background", "pan_to", {
		location = selectors.background_location(state),
	})

	msg.post("/cylinder#cylinder", "set_target", {
		anchor = selectors.cylinder_anchor(state),
	})
end

local function request_turn_sync(self)
	self.needs_turn_sync = true
end

local function bind_store(self)
	self.store = store_mod.get()
	self.subs = {}

	if not self.store then
		return false
	end

	self.subs[#self.subs + 1] = self.store:subscribe("turn", function(_state)
		request_turn_sync(self)
	end)
	self.subs[#self.subs + 1] = self.store:subscribe("ui", function(_state)
		request_turn_sync(self)
	end)

	sync_turn(self, self.store:get_state())
	self.needs_turn_sync = false
	return true
end

function init(self)
	self.store = nil
	self.subs = {}
	self.active_kind = nil
	self.needs_turn_sync = false

	bind_store(self)
end

function update(self, dt)
	if self.needs_turn_sync and self.store then
		self.needs_turn_sync = false
		sync_turn(self, self.store:get_state())
	end
end

function on_message(self, message_id, message)
	if message_id == hash("boot") and not self.store then
		bind_store(self)
	elseif message_id == hash("boot") and self.store then
		sync_turn(self, self.store:get_state())
		self.needs_turn_sync = false
	elseif message_id == hash("background_pan_complete") then
		self.last_background_location = message.location
	elseif message_id == hash("duel_sequence_complete") and self.store then
		local actions = require("game.model.actions")
		self.store:dispatch(actions.round_advance())
	end
end

function final(self)
	if self.store and self.subs then
		for _, token in ipairs(self.subs) do
			self.store:unsubscribe(token)
		end
	end
end
